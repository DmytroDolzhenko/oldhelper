PORT=3000
PUBLIC_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=123456:telegram-token-from-botfather
TELEGRAM_MODE=polling
RUSTPLUS_CONFIG_FILE=./rustplus.config.json
# For Render and other hosts without persistent files, use a Base64 value instead.
# Create it locally with the command in README. Never commit the decoded JSON.
RUSTPLUS_CONFIG_BASE64=

# Use json for local testing. Use supabase on free cloud hosts.
STORAGE_DRIVER=json
DATA_FILE=./data.json

# Required when STORAGE_DRIVER=supabase.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: sends Rust+ events to Telegram only once per entity cooldown window.
ALERT_COOLDOWN_SECONDS=60
FCM_MEMORY_LIMIT_MB=180
